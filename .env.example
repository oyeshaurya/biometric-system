# Copy to .env and adjust. The .env file is gitignored.

# Path to the 32-byte Fernet key file. MUST be outside the data/ folder and readable
# only by the current user. Generate with: python -m biometric_lab.scripts.make_key
BIOMETRIC_LAB_KEY_FILE=../biometric_lab.key

# SQLAlchemy database URL. Default is a local SQLite file under data/.
BIOMETRIC_LAB_DB_URL=sqlite:///data/biometric.db

# Bind address. Keep on loopback. A non-loopback value triggers a startup warning.
BIOMETRIC_LAB_HOST=127.0.0.1
BIOMETRIC_LAB_PORT=8000

# Session signing secret (any long random string).
# Generate with: python -m biometric_lab.scripts.make_key --secret
BIOMETRIC_LAB_SESSION_SECRET=change-me-to-a-long-random-string

# Face engine: "fake" (default, no model), "insightface", or "yunet_sface".
BIOMETRIC_LAB_ENGINE=fake

# Retention (days). 0 disables the template sweep.
BIOMETRIC_LAB_TEMPLATE_RETENTION_DAYS=0
